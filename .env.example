# Copy to .env. Keep .env private and out of Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Optional in development; required in production: 32+ random characters.
# Blank in development generates an ephemeral secret at startup.
SESSION_SECRET=

# Production must be the exact HTTPS origin, with no trailing slash or path.
APP_ORIGIN=http://localhost:5173

# Optional absolute path; blank defaults to server/data/monohaus.sqlite.
DATABASE_PATH=

# Use 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
